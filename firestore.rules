rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'brfariarm@gmail.com' && request.auth.token.email_verified == true;
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'items', 'total', 'status'])
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50;
      allow get: if true;
      allow list: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /flavor_options/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /topping_options/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /closeouts/{closeoutId} {
      allow read, write: if isAdmin();
    }

    match /conversas_bot/{phoneId} {
      allow read, write: if isAdmin();
    }

    match /mensagens_processadas/{msgId} {
      allow read, write: if isAdmin();
    }

    match /private_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /support_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}

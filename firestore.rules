rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rede de segurança: nega tudo por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'brfariarm@gmail.com';
    }

    // Cardápio, sabores e adicionais: todos podem ler, SÓ o administrador altera
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /flavor_options/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /topping_options/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configurações da loja: leitura pública, escrita só do administrador
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fechamento de caixa: só administrador
    match /closeouts/{closeoutId} {
      allow read, write: if isAdmin();
    }

    // Pedidos (livre para clientes criarem e lerem/listarem, admin gerencia)
    match /orders/{orderId} {
      allow create: if true;
      allow get: if true;
      allow list: if true;
      allow update, delete: if true;
    }

    // Conversas do WhatsApp e conversas_bot
    match /whatsapp_conversations/{phoneId} {
      allow read, write: if true;
    }

    match /conversas_bot/{phoneId} {
      allow read, write: if true;
    }

    // Dados privados: SOMENTE o administrador lê e escreve
    match /private_settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Solicitações de suporte humano (Opção 4 do bot de WhatsApp)
    match /support_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if true;
    }
  }
}

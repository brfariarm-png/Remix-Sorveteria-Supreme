rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rede de segurança: nega tudo por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'brfariarm@gmail.com' &&
        request.auth.token.email_verified == true
      );
    }

    // Cardápio, sabores e adicionais: todos podem ler, SÓ o administrador altera
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /flavor_options/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /topping_options/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configurações da loja: leitura pública (NÃO guarde senhas/tokens aqui), escrita só do administrador
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fechamento de caixa: só administrador
    match /closeouts/{closeoutId} {
      allow read, write: if isAdmin();
    }

    // Pedidos
    match /orders/{orderId} {
      // Cliente/convidado só pode criar pedido novo, aguardando, com dados válidos
      function isValidNewOrder() {
        let d = request.resource.data;
        return d.status == 'waiting'
          && d.id == orderId
          && d.total is number
          && d.total >= 0
          && d.total < 100000
          && d.items is list
          && d.items.size() > 0
          && d.items.size() <= 100
          && d.ownerId is string
          && (!isSignedIn() || d.ownerId == request.auth.uid || d.ownerId == 'totem-kiosk-client' || d.ownerId.matches('guest-.*'));
      }

      allow create: if isAdmin() || isValidNewOrder();

      // Acompanhar um pedido exige conhecer o ID (agora longo e aleatório)
      allow get: if true;

      // Listar: só administrador, ou o cliente logado vendo os próprios pedidos
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      // Alterar ou apagar pedidos: somente administrador
      allow update, delete: if isAdmin();
    }
    // Dados privados (chaves de pagamento PIX, etc.): SOMENTE o administrador lê e escreve
    match /private_settings/{docId} {
      allow read, write: if isAdmin();
    }
  }
}

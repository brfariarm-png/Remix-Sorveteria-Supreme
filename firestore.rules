rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'brfariarm@gmail.com';
    }

    // Cardápio, sabores e adicionais: leitura pública, escrita só do admin
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /flavor_options/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /topping_options/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configurações da loja: leitura pública, escrita só do admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fechamento de caixa: só admin
    match /closeouts/{closeoutId} {
      allow read, write: if isAdmin();
    }

    // Pedidos: Clientes criam e leem. Admin lê todos, atualiza e arquiva. Ninguém apaga.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Conversas e mensagens do bot: acesso geral para webhook e painel
    match /conversas_bot/{phoneId} {
      allow read, write: if true;
    }

    match /mensagens_processadas/{msgId} {
      allow read, write: if true;
    }

    match /private_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /support_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}

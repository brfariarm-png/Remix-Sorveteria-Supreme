rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'brfariarm@gmail.com';
    }

    // Cardápio, sabores e adicionais: leitura pública, escrita só do administrador
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /flavor_options/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /topping_options/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configurações da loja: leitura pública, escrita só do administrador
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fechamento de caixa: só administrador
    match /closeouts/{closeoutId} {
      allow read, write: if isAdmin();
    }

    // Pedidos: criados e lidos por clientes/administradores com validação
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'items', 'total', 'status'])
                    && request.resource.data.total is number
                    && request.resource.data.items is list;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Conversas do bot: somente administrador
    match /conversas_bot/{phoneId} {
      allow read, write: if isAdmin();
    }

    // Configurações privadas: somente administrador
    match /private_settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Solicitações de suporte humano: criadas por qualquer um, gerenciadas pelo administrador
    match /support_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
